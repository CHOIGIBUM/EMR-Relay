# 브라우저에 포함되어도 되는 공개 설정만 둡니다.
# AWS 자격 증명, 공공데이터 인증키, Kakao REST/Admin 키, 사용자 암호는 절대 추가하지 않습니다.

# local: 브라우저에 포함된 명시적 검증 fixture
# remote: API Gateway와 AgentCore를 사용하는 운영 경로
NEXT_PUBLIC_EMS_API_MODE=local
NEXT_PUBLIC_EMS_BACKEND_URL=
NEXT_PUBLIC_EMS_ALLOW_LOCAL_FALLBACK=false
NEXT_PUBLIC_EMS_REVIEWER_ID=PARAMEDIC-01

NEXT_PUBLIC_EMS_OPERATIONAL_MODE=local
NEXT_PUBLIC_EMS_DEFAULT_CASE_ID=GW-CARDIO-052
NEXT_PUBLIC_EMS_ALLOW_DEVELOPMENT_FALLBACK=false
NEXT_PUBLIC_EMS_SCRIPTED_PTT=false

# Cognito Hosted UI (Authorization Code + PKCE)
NEXT_PUBLIC_COGNITO_DOMAIN=
NEXT_PUBLIC_COGNITO_CLIENT_ID=
NEXT_PUBLIC_COGNITO_REDIRECT_URI=http://localhost:3000/auth/callback
NEXT_PUBLIC_COGNITO_LOGOUT_URI=http://localhost:3000/login
NEXT_PUBLIC_EMS_DEV_AUTH=false

# 공개 JavaScript 키만 허용합니다. Kakao 콘솔에 실제 Amplify 도메인을 등록해야 합니다.
NEXT_PUBLIC_KAKAO_MAP_JAVASCRIPT_KEY=
