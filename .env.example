# local: 프로젝트의 명시적 로컬 검증 API 사용
# remote: API Gateway/AgentCore 백엔드 사용
NEXT_PUBLIC_EMS_API_MODE=local

# remote 모드에서 사용하는 API Gateway stage URL입니다.
# 예: https://abc123.execute-api.us-west-2.amazonaws.com/v1
NEXT_PUBLIC_EMS_BACKEND_URL=

# local 모드 및 명시적 fallback 경로입니다.
NEXT_PUBLIC_EMS_LOCAL_API_BASE=/api/local

# 기본값은 false입니다. remote 장애를 로컬 임상 fixture로 숨기지 않습니다.
# 네트워크 오류/5xx에서만 fallback하며, 인증·검증 4xx에는 적용하지 않습니다.
NEXT_PUBLIC_EMS_ALLOW_LOCAL_FALLBACK=false

# 원격 확정 요청의 검토자 식별자입니다. 운영에서는 Cognito 로그인 정보로 대체합니다.
NEXT_PUBLIC_EMS_REVIEWER_ID=PARAMEDIC-01

# 호환용 기존 설정입니다. 새 환경에서는 위 변수를 사용하세요.
# NEXT_PUBLIC_EMS_API_BASE=/api/local
