{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems-relay.local/schemas/confirm-request.schema.json",
  "title": "EMS Relay HITL confirmation request",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposalId", "expectedVersion", "reviewedBy", "decisions"],
  "properties": {
    "proposalId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
    "expectedVersion": { "type": "integer", "minimum": 0 },
    "reviewedBy": { "type": "string", "minLength": 1, "maxLength": 100 },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["changeId", "action"],
        "properties": {
          "changeId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
          "action": { "type": "string", "enum": ["accept", "reject"] },
          "value": {
            "anyOf": [
              { "type": "string" },
              { "type": "number" },
              { "type": "boolean" },
              { "type": "null" },
              { "type": "array", "items": { "type": "string" } }
            ]
          }
        }
      }
    }
  }
}
