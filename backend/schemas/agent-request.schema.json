{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ems-relay.local/schemas/agent-request.schema.json",
  "title": "EMS Relay agent request",
  "type": "object",
  "additionalProperties": false,
  "required": ["case_id", "update_id", "transcript"],
  "properties": {
    "case_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$" },
    "update_id": { "type": "string", "minLength": 1, "maxLength": 100 },
    "transcript": { "type": "string", "minLength": 1, "maxLength": 10000 },
    "locale": { "type": "string", "const": "ko-KR" },
    "client_event_id": { "type": "string", "minLength": 1, "maxLength": 100 }
  }
}
